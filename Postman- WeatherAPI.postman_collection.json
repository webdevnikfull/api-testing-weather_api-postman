  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Script to initialize the 'moment' library in Postman\r",
          "const moment = require('moment');\r",
          "\r",
          "// Yesterday (subtract 1 day)\r",
          "pm.collectionVariables.set('Yesterday', moment().subtract(1, 'day').format('YYYY-MM-DD'));\r",
          "\r",
          "// Month ago (subtract 1 month)\r",
          "pm.collectionVariables.set('month_ago', moment().subtract(1, 'month').format('YYYY-MM-DD'));\r",
          "\r",
          "// Start of week\r",
          "pm.collectionVariables.set('start_of_week', moment().startOf('isoWeek').format('YYYY-MM-DD'));\r",
          "\r",
          "// Start of month\r",
          "pm.collectionVariables.set('start_of_month', moment().startOf('month').format('YYYY-MM-DD'));"
        ]
      }
    },
